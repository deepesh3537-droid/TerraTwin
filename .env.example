# ==============================================================================
# TerraTwin Environment Variables Template (.env.example)
# Copy this file to .env for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=TerraTwin
DEBUG=True
API_V1_PREFIX=/api/v1

# Database: PostgreSQL + PostGIS (Docker Compose default)
# IMPORTANT: "change_me" is a local development default. Never use in production.
DATABASE_URL=postgresql+psycopg://terratwin:change_me@localhost:5432/terratwin

# CORS Origins: Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Data Root Directory (relative to backend folder or absolute path)
DATA_ROOT=../data

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# Note: Variables prefixed with VITE_ are embedded into client bundles. Never put secrets here.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Earth Map Style URL (e.g. Carto Positron / OSM style JSON / tile URL).
# Optional: Leave empty to render neutral fallback canvas per ADR-006.
VITE_EARTH_MAP_STYLE_URL=
