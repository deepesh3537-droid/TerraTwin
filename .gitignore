# Vite cache
.vite/
frontend/.vite/

# Large Datasets and GIS rasters / archives (per ADR-010)
# Large files stay out of Git; keep only directory structure via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.tif
*.tiff
*.geotiff
*.nc
*.hdf
*.hdf5
*.h5
*.jp2
*.img
*.tar.gz
*.zip
!docs/*.zip

# Database data directories
postgres-data/
pgdata/

# OS and Editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
